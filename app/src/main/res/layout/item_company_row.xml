<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingTop="10dp"
    android:paddingEnd="4dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/row_icon"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:contentDescription="@string/label_name"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_company_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/ink"
            android:textSize="16sp"
            tools:text="Име на компанија" />

        <TextView
            android:id="@+id/row_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:alpha="0.8"
            android:textColor="@color/ink"
            android:textSize="13sp"
            tools:text="Адреса" />

        <TextView
            android:id="@+id/row_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/ink"
            android:textSize="13sp"
            tools:text="07x xxx xxx" />

        <TextView
            android:id="@+id/row_website"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:alpha="0.85"
            android:textColor="@color/ink"
            android:textSize="12sp"
            tools:text="https://..." />
    </LinearLayout>
</LinearLayout>
